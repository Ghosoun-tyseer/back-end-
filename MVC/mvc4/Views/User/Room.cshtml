@{
}



@{
    
    var rooms = new[]
    {
        new {
            Title = "Single",
            Description = "A cozy and comfortable room designed for one guest. Ideal for solo travelers.",
            Image = "https://lnt-lda.com/images/facilities-gallery/single/4-1.JPG",
            ButtonText = "View Room"
        },
        new {
            Title = "Double",
            Description = "A spacious and elegant room for two guests, offering a queen-size or two twin beds for comfort.",
            Image = "https://roomraccoon.com/wp-content/uploads/2024/06/2-1.png",
            ButtonText = "View Room"
        },
        new {
            Title = "Triple",
            Description = "A versatile and roomy accommodation for three guests. Ideal for families or small groups.",
            Image = "https://tse2.mm.bing.net/th/id/OIP.0iOAA0OtOGoleuSw-zHAxAHaE8?r=0&rs=1&pid=ImgDetMain&o=7&rm=3", 
            ButtonText = "View Room"
        }
    };
}

<div class="container-fluid py-5" style="background-color: #fdf2d9;">
   

    <div class="text-center mb-5">
        <h1 class="display-5 fw-normal">Extraordinary rooms with elegant,</h1>
        <h1 class="display-5 fw-normal">yet a a rustic atmosphere</h1>
    </div>

    <div class="container">
        <div class="row g-4 justify-content-center">
            @foreach (var room in rooms)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 border-0 shadow-sm overflow-hidden">

                        <img src="@room.Image" class="card-img-top" alt="@room.Title" style="height: 300px; object-fit: cover;">

                        <div class="card-body p-4">
                            <h4 class="card-title fw-bold">@room.Title</h4>
                            <p class="card-text text-muted mb-4">
                                @room.Description
                            </p>


                            <a href="#" class="btn btn-primary px-4 py-2">
                                @room.ButtonText
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
