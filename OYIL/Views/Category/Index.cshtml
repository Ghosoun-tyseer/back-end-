@{
}

<div class="container">
    <div class="row">
        @model List<Category>
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card" style="width: 18rem;">
                    <img class="card-img-top" src="@item.ImageUrl" alt="Card image cap">
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">@item.Description</p>

                        <a asp-action="ProductsByCategory"
                           asp-route-id="@item.CategoryId" class="btn btn-primary btn-sm">View All Products</a>

                        <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-warning btn-sm me-2">   Edit </a>

                        <a asp-action="Delete" asp-route-CategoryId="@item.CategoryId" class="btn btn-danger btn-sm">
                            Delete
                        </a>
                    </div>
                </div>
            </div>


        }

    </div>

</div>